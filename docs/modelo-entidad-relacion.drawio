<mxfile host="app.diagrams.net" modified="2026-11-05T16:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="NexoEventos_ERD" name="Diagrama Entidad-Relación NexoEventos">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- TITULO -->
        <mxCell id="title" value="MODELO ENTIDAD - RELACIÓN: SISTEMA NEXOEVENTOS (CORE + MÓDULO CALENDARIO)&#xa;Base de Datos Relacional MySQL 8.0 (utf8mb4) | Timezone: America/Costa_Rica (UTC-6)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="1050" height="50" as="geometry" />
        </mxCell>

        <!-- SECCION 1: ENTIDADES ACADÉMICAS BÁSICAS (6 TABLAS) -->

        <!-- ENTIDAD ROLES -->
        <mxCell id="ent_roles" value="ROLES&#xa;(Catálogo de roles del sistema)&#xa;--------------------------------------------&#xa;PK  id_rol : INT (AI)&#xa;      nombre : VARCHAR(40) [UNIQUE]&#xa;      descripcion : VARCHAR(200)" style="shape=swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1E1E1E;fontColor=#D4AF37;strokeColor=#D4AF37;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="260" height="130" as="geometry" />
        </mxCell>

        <!-- ENTIDAD USUARIOS -->
        <mxCell id="ent_usuarios" value="USUARIOS&#xa;(Credenciales y autenticación)&#xa;--------------------------------------------&#xa;PK  id_usuario : INT (AI)&#xa;FK  id_rol : INT [NOT NULL]&#xa;FK  id_cliente : INT [NULL, UNIQUE]&#xa;      nombre : VARCHAR(120) [NOT NULL]&#xa;      correo : VARCHAR(120) [UNIQUE, NOT NULL]&#xa;      password : VARCHAR(255) [bcrypt HASH]&#xa;      fecha_creacion : DATETIME [DEFAULT NOW]" style="shape=swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1E1E1E;fontColor=#D4AF37;strokeColor=#D4AF37;" vertex="1" parent="1">
          <mxGeometry x="460" y="80" width="290" height="190" as="geometry" />
        </mxCell>

        <!-- ENTIDAD CLIENTES -->
        <mxCell id="ent_clientes" value="CLIENTES&#xa;(Titulares de eventos)&#xa;--------------------------------------------&#xa;PK  id_cliente : INT (AI)&#xa;      tipo_cliente : ENUM('persona', 'empresa')&#xa;      nombre : VARCHAR(120) [NOT NULL]&#xa;      correo : VARCHAR(120)&#xa;      telefono : VARCHAR(20)&#xa;      direccion : VARCHAR(200)&#xa;      fecha_registro : DATETIME [DEFAULT NOW]" style="shape=swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1E1E1E;fontColor=#D4AF37;strokeColor=#D4AF37;" vertex="1" parent="1">
          <mxGeometry x="870" y="80" width="290" height="180" as="geometry" />
        </mxCell>

        <!-- ENTIDAD EVENTOS -->
        <mxCell id="ent_eventos" value="EVENTOS&#xa;(Planificación comercial y reservas)&#xa;--------------------------------------------&#xa;PK  id_evento : INT (AI)&#xa;FK  id_cliente : INT [NOT NULL]&#xa;      nombre : VARCHAR(120) [NOT NULL]&#xa;      tipo_evento : VARCHAR(50) [NOT NULL]&#xa;      fecha_evento : DATE [NOT NULL]&#xa;      ubicacion : VARCHAR(200) [NOT NULL]&#xa;      estado : ENUM('pendiente', 'confirmado',&#xa;                    'completado', 'cancelado')" style="shape=swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1E1E1E;fontColor=#D4AF37;strokeColor=#D4AF37;" vertex="1" parent="1">
          <mxGeometry x="870" y="340" width="290" height="200" as="geometry" />
        </mxCell>

        <!-- ENTIDAD DETALLE_EVENTOS -->
        <mxCell id="ent_detalle_eventos" value="DETALLE_EVENTOS&#xa;(Servicios contratados por evento)&#xa;--------------------------------------------&#xa;PK  id_detalle : INT (AI)&#xa;FK  id_evento : INT [NOT NULL]&#xa;FK  id_servicio : INT [NOT NULL]&#xa;      cantidad : INT [> 0]&#xa;      precio_unitario : DECIMAL(10,2) [>= 0]&#xa;      -- Precio pactado congelado" style="shape=swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1E1E1E;fontColor=#D4AF37;strokeColor=#D4AF37;" vertex="1" parent="1">
          <mxGeometry x="460" y="355" width="290" height="170" as="geometry" />
        </mxCell>

        <!-- ENTIDAD SERVICIOS -->
        <mxCell id="ent_servicios" value="SERVICIOS&#xa;(Catálogo de prestaciones)&#xa;--------------------------------------------&#xa;PK  id_servicio : INT (AI)&#xa;      nombre : VARCHAR(120) [NOT NULL]&#xa;      descripcion : TEXT&#xa;      precio : DECIMAL(10,2) [>= 0]&#xa;      estado : ENUM('activo', 'inactivo')" style="shape=swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1E1E1E;fontColor=#D4AF37;strokeColor=#D4AF37;" vertex="1" parent="1">
          <mxGeometry x="90" y="365" width="270" height="150" as="geometry" />
        </mxCell>

        <!-- SECCION 2: ENTIDADES DE EXTENSIÓN PARA CALENDARIO (4 TABLAS) -->

        <!-- ENTIDAD CATEGORIAS_AGENDA -->
        <mxCell id="ent_categorias_agenda" value="CATEGORIAS_AGENDA&#xa;(Catálogo de tipos de agenda)&#xa;--------------------------------------------&#xa;PK  id_categoria : INT (AI)&#xa;      nombre : VARCHAR(60) [UNIQUE]&#xa;      color : VARCHAR(20) [HEX / CSS]&#xa;      descripcion : VARCHAR(255)" style="shape=swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1E1E1E;fontColor=#D4AF37;strokeColor=#D4AF37;" vertex="1" parent="1">
          <mxGeometry x="90" y="600" width="270" height="150" as="geometry" />
        </mxCell>

        <!-- ENTIDAD AGENDAS -->
        <mxCell id="ent_agendas" value="AGENDAS&#xa;(Actividades y citas de calendario)&#xa;--------------------------------------------&#xa;PK  id_agenda : INT (AI)&#xa;FK  id_categoria : INT [NOT NULL]&#xa;FK  id_evento : INT [NULL]&#xa;FK  id_responsable : INT [NOT NULL]&#xa;      titulo : VARCHAR(150) [NOT NULL]&#xa;      descripcion : TEXT&#xa;      fecha_inicio : DATETIME [NOT NULL]&#xa;      fecha_fin : DATETIME [NOT NULL]&#xa;      ubicacion : VARCHAR(200) [NOT NULL]&#xa;      imagen_portada : VARCHAR(255) NULL&#xa;      estado : VARCHAR(30) [programada/completada]&#xa;      fecha_creacion : DATETIME [DEFAULT NOW]&#xa;      fecha_actualizacion : DATETIME [ON UPDATE NOW]" style="shape=swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1E1E1E;fontColor=#D4AF37;strokeColor=#D4AF37;" vertex="1" parent="1">
          <mxGeometry x="460" y="580" width="310" height="260" as="geometry" />
        </mxCell>

        <!-- ENTIDAD AGENDA_INTEGRANTES -->
        <mxCell id="ent_agenda_integrantes" value="AGENDA_INTEGRANTES&#xa;(Equipo asignado a la actividad)&#xa;--------------------------------------------&#xa;PK,FK  id_agenda : INT&#xa;PK,FK  id_usuario : INT&#xa;          fecha_asignacion : DATETIME [NOW]" style="shape=swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1E1E1E;fontColor=#D4AF37;strokeColor=#D4AF37;" vertex="1" parent="1">
          <mxGeometry x="870" y="600" width="290" height="130" as="geometry" />
        </mxCell>

        <!-- ENTIDAD AGENDA_NOTAS -->
        <mxCell id="ent_agenda_notas" value="AGENDA_NOTAS&#xa;(Checklist y notas operativas)&#xa;--------------------------------------------&#xa;PK  id_nota : INT (AI)&#xa;FK  id_agenda : INT [NOT NULL]&#xa;FK  id_usuario : INT [NOT NULL]&#xa;      descripcion : TEXT [NOT NULL]&#xa;      completada : BOOLEAN [DEFAULT FALSE]&#xa;      fecha_limite : DATETIME NULL&#xa;      fecha_creacion : DATETIME [DEFAULT NOW]" style="shape=swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#1E1E1E;fontColor=#D4AF37;strokeColor=#D4AF37;" vertex="1" parent="1">
          <mxGeometry x="460" y="900" width="310" height="170" as="geometry" />
        </mxCell>

        <!-- RELACIONES Y CONECTORES -->

        <!-- ROLES (1) <-> (N) USUARIOS -->
        <mxCell id="rel_roles_usuarios" value="1 : N&#xa;(asigna rol)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D4AF37;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="ent_roles" target="ent_usuarios">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CLIENTES (1) <-> (0..1) USUARIOS -->
        <mxCell id="rel_usuarios_clientes" value="N : 1 / 1 : 1&#xa;(cuenta cliente)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D4AF37;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="ent_clientes" target="ent_usuarios">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CLIENTES (1) <-> (N) EVENTOS -->
        <mxCell id="rel_clientes_eventos" value="1 : N&#xa;(solicita / posee)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D4AF37;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="ent_clientes" target="ent_eventos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EVENTOS (1) <-> (N) DETALLE_EVENTOS -->
        <mxCell id="rel_eventos_detalles" value="1 : N&#xa;(contiene)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D4AF37;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="ent_eventos" target="ent_detalle_eventos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SERVICIOS (1) <-> (N) DETALLE_EVENTOS -->
        <mxCell id="rel_servicios_detalles" value="1 : N&#xa;(desglosado en)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D4AF37;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="ent_servicios" target="ent_detalle_eventos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CATEGORIAS_AGENDA (1) <-> (N) AGENDAS -->
        <mxCell id="rel_categorias_agendas" value="1 : N&#xa;(clasifica)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D4AF37;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="ent_categorias_agenda" target="ent_agendas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EVENTOS (1) <-> (0..N) AGENDAS -->
        <mxCell id="rel_eventos_agendas" value="1 : 0..N&#xa;(actividades operativas)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.25;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D4AF37;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="ent_eventos" target="ent_agendas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- USUARIOS (1) <-> (N) AGENDAS (Responsable) -->
        <mxCell id="rel_usuarios_agendas" value="1 : N&#xa;(responsable PIC)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D4AF37;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="ent_usuarios" target="ent_agendas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AGENDAS (1) <-> (N) AGENDA_INTEGRANTES -->
        <mxCell id="rel_agendas_integrantes" value="1 : N&#xa;(asigna personal)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D4AF37;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="ent_agendas" target="ent_agenda_integrantes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AGENDAS (1) <-> (N) AGENDA_NOTAS -->
        <mxCell id="rel_agendas_notas" value="1 : N&#xa;(contiene notas/tareas)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeWidth=2;strokeColor=#D4AF37;fontStyle=1;fontColor=#000000;" edge="1" parent="1" source="ent_agendas" target="ent_agenda_notas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- NOTA EXPLICATIVA -->
        <mxCell id="nota_erd" value="REGLAS DE INTEGRIDAD REFERENCIAL Y DE ARQUITECTURA (NEXOEVENTOS):&#xa;1. `roles` contiene exactamente 3 roles del sistema: 'administrador', 'supervisor', 'cliente'. Catálogo cerrado inmutable.&#xa;2. `usuarios.id_cliente` es UNIQUE y NULLABLE: los clientes solo pueden vincularse a una cuenta de usuario. Administradores y supervisores tienen id_cliente = NULL.&#xa;3. `detalle_eventos` es la entidad débil asociativa que resuelve la relación N:M entre `eventos` y `servicios`, con congelación de precio histórico (`precio_unitario`).&#xa;4. `agendas` estructura citas operativas con validación de conflicto de intervalos `(inicio < fin2 AND fin > inicio2)` tanto para el responsable como para integrantes.&#xa;5. `categorias_agenda` almacena los 4 tipos estándar: 'Event', 'Meeting', 'Setup and Rehearsal', 'Task Deadlines'.&#xa;6. Zona horaria institucional estándar: America/Costa_Rica (UTC-6)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8E1;strokeColor=#D4AF37;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="90" y="1120" width="1070" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
