{
  "name": "nexoeventos-backend",
  "version": "1.0.0",
  "description": "Backend API para NexoEventos - Sistema de gestión de eventos",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "migrate:status": "node src/scripts/migrate.js --status",
    "seed": "node src/scripts/seed.js",
    "test:api": "node src/scripts/testEndpoints.js",
    "test:persistence": "node src/scripts/testDirectMySQLPersistence.js",
    "test:commercial": "node src/scripts/testCommercialWorkflow.js",
    "test:socket": "node src/scripts/testSocket.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
